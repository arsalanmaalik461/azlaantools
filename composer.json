{
    "name": "azlaan/tools-hub",
    "type": "project",
    "description": "Azlaan Tools - Free online tools hub for Pakistan (bills, solar, PDF, image, utilities). No signup, all tools run in the browser.",
    "keywords": ["laravel", "tools", "pakistan"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}